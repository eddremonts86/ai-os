#!/usr/bin/env bash
# setup/hooks/pre-push — local gate before anything reaches GitHub (~10s).
#
# Enabled per clone by install-mac.sh (`git config core.hooksPath setup/hooks`).
# Skip once, deliberately: git push --no-verify
#
# Runs what CI runs on every OS runner, plus the checks that would have caught
# today's (2026-11-05) breakages before CI did: invalid YAML in skill
# frontmatter, a syntax error in a setup script, an invalid compose file,
# a direct push to main, and a new critical/high security finding (aios-security-audit scan, baseline mode).
# Windows' install-windows.dry-run.ps1 only runs here when pwsh is installed.

set -uo pipefail

PY="$HOME/.ai-os/venv/bin/python"
[ -x "$PY" ] || PY=python3

failed=0
step() { printf '[pre-push] %-34s' "$1"; }
pass() { echo "ok${1:+ ($1)}"; }
fail() { echo "FAIL"; printf '%s\n' "$1" | sed 's/^/           /' | head -15; failed=$((failed + 1)); }

# The flow is feature → dev → main, and main only changes through a dev → main PR
# (guard-main.yml checks the PR side; branch protection needs a paid plan, so this
# hook is the push side). Hotfix escape hatch: AIOS_ALLOW_MAIN_PUSH=1 git push ...
ZERO=0000000000000000000000000000000000000000
ORIG="$(git rev-parse --show-toplevel)"   # the real checkout: only it has the untracked .env
sha=""
base=""
ranges=()
while read -r _local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" != "$ZERO" ]; then
    if [ "$remote_sha" = "$ZERO" ]; then ranges+=("$local_sha --not --remotes"); else ranges+=("$remote_sha..$local_sha"); fi
  fi
  if [ "$remote_ref" = "refs/heads/main" ] && [ "${AIOS_ALLOW_MAIN_PUSH:-0}" != "1" ]; then
    echo "[pre-push] blocked: direct push to main. Push to dev (or a feature branch) and open a PR:"
    echo "           git push origin HEAD:dev && gh pr create --base main --head dev"
    echo "           Hotfix only: AIOS_ALLOW_MAIN_PUSH=1 git push origin main"
    exit 1
  fi
  [ "$local_sha" != "$ZERO" ] && sha="$local_sha"
  [ "$remote_sha" != "$ZERO" ] && base="$remote_sha"
done
[ -z "$sha" ] && { echo "[pre-push] only deletions — nothing to check"; exit 0; }

# Check the commit being pushed, not the working tree: uncommitted edits must
# neither hide a broken commit nor fail a good one.
WT="$(mktemp -d -t aios-prepush-XXXX)"
trap 'git worktree remove --force "$WT" >/dev/null 2>&1; rm -rf "$WT"' EXIT
git worktree add --detach --quiet "$WT" "$sha" || { echo "[pre-push] could not check out $sha"; exit 1; }
cd "$WT" || exit 1
echo "[pre-push] checking ${sha:0:9}"

step "shell syntax"
out=""
while IFS= read -r f; do
  # setup/hooks/ also holds Python; only syntax-check what is actually shell.
  case "$f" in *.sh) ;; *) head -1 "$f" | grep -qE '^#!.*\b(ba)?sh\b' || continue ;; esac
  e=$(bash -n "$f" 2>&1) || out+="$f: $e"$'\n'
done < <(git ls-files '*.sh' 'ai-os' 'setup/hooks/*' | grep -v '^vendor/')
[ -z "$out" ] && pass || fail "$out"

step "node syntax (setup/, llm/)"
out=""
if command -v node >/dev/null 2>&1; then
  while IFS= read -r f; do
    e=$(node --check "$f" 2>&1) || out+="$f: ${e%%$'\n'*}"$'\n'
  done < <(git ls-files 'setup/*.mjs' 'setup/*.js' 'llm/*.mjs' 'llm/*.js')
  [ -z "$out" ] && pass || fail "$out"
else
  pass "node not installed, skipped"
fi

step "YAML + skill frontmatter"
out=$("$PY" - <<'EOF' 2>&1
import glob, sys
try:
    import yaml
except ImportError:
    print("PyYAML missing — install it or run setup/install-mac.sh"); sys.exit(1)
bad = []
files = (glob.glob("ai-config/mcp/*.yaml") + glob.glob(".github/workflows/*.yml")
         + ["ai-config/manifest.yaml", "memory/docker-compose.yml", "memory/graphiti/config.yaml"])
for f in files:
    try:
        yaml.safe_load(open(f))
    except Exception as e:
        bad.append(f"{f}: {str(e).splitlines()[0]}")
skills = (glob.glob("ai-config/skills/*/SKILL.md") + glob.glob("vendor/ecc/skills/*/SKILL.md")
          + glob.glob("vendor/gstack/*/SKILL.md"))
for f in skills:
    text = open(f, encoding="utf-8").read()
    if not text.startswith("---"):
        bad.append(f"{f}: no frontmatter"); continue
    try:
        fm = yaml.safe_load(text.split("---", 2)[1]) or {}
    except Exception as e:  # strict parsers (Codex, Gemini) reject what Claude tolerates
        bad.append(f"{f}: {str(e).splitlines()[0]}"); continue
    for key in ("name", "description"):
        if not fm.get(key):
            bad.append(f"{f}: missing {key}")
print("\n".join(bad)); sys.exit(1 if bad else 0)
EOF
) && pass || fail "$out"

step "skill catalogue (budget + routing)"
out=$("$PY" setup/ai-os-skills.py lint --strict 2>&1) && out2=$("$PY" setup/ai-os-skills.py bank 2>&1) && pass "$(grep -oE '[0-9]+/[0-9]+ requests' <<<"$out2")" || fail "$(grep -E '❌|alarm' <<<"$out"$'\n'"${out2:-}" | head -8)"

step "docker compose config"
if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
  out=$(docker compose -f memory/docker-compose.yml config --quiet 2>&1) && pass || fail "$out"
else
  pass "docker compose not installed, skipped"
fi

step "published numbers (ai-os stats)"
out=$(python3 setup/ai-os-stats.py --check 2>&1) && pass || fail "$out"

step "no .env value in what you push"
out=""
for r in ${ranges[@]+"${ranges[@]}"}; do
  # shellcheck disable=SC2086  # $r is "A..B" or "SHA --not --remotes": word splitting is intended
  e=$(cd "$ORIG" && python3 "$ORIG/setup/ai-os-secrets.py" check-push -- $r 2>&1) || out+="$e"$'\n'
done
[ -z "$out" ] && pass || fail "a value from dev-env/env-config/.env is in the commits being pushed (names only):
$out"

step "security scan (new findings)"
# aios-security-audit's scanners, baseline mode: only what this push adds. A new critical or high finding blocks.
# A scanner that is not installed is NOT RUN, and nothing running at all blocks too: that is not "clean".
[ -n "$base" ] || base=$(git rev-parse --verify -q origin/dev || git rev-parse --verify -q origin/main || true)
secargs=(); [ -n "$base" ] && secargs=(--baseline "$base")
SECOUT="$(mktemp -d -t aios-prepush-sec-XXXX)"
out=$("$PY" ai-config/skills/aios-security-audit/scripts/scan.py . ${secargs[@]+"${secargs[@]}"} --out "$SECOUT" 2>&1); rc=$?
case "$rc" in
  0) pass "$(grep -oE '^[0-9]+ findings' <<<"$out" | head -1)" ;;
  1) fail "this push adds a critical or high finding:
$(grep -E '^\| (critical|high) ' "$SECOUT/summary.md" | head -8)
Run /aios-security-review for the detail, fix it, then push again." ;;
  *) fail "no scanner could run, which is not clean. Install them: brew bundle --file dev-env/packages/Brewfile" ;;
esac
rm -rf "${SECOUT:?}"

step "setup unit tests"
out=$("$PY" -m unittest discover -s setup/tests 2>&1) && pass "$(grep -oE 'Ran [0-9]+ tests' <<<"$out")" || fail "$(tail -15 <<<"$out")"

step "create-ai-os tests"
# Zero dependencies and a stand-in git/installer, so it runs in the bare worktree. The site's
# tests need its node_modules and run in CI (test-apps.yml). `node --test <glob>` needs Node 22+.
if command -v node >/dev/null 2>&1 && [ "$(node -p 'process.versions.node.split(".")[0]')" -ge 22 ]; then
  out=$(cd apps/create-ai-os && node --test 'test/**/*.test.js' 2>&1) && pass "$(grep -oE 'pass [0-9]+' <<<"$out" | head -1)" || fail "$(grep -E '^\s*(✖|not ok)|failing tests' <<<"$out" | head -10)"
else
  pass "Node 22+ not installed, skipped"
fi

step "install-mac dry-run"
out=$(bash setup/install-mac.dry-run.sh 2>&1) && pass || fail "$(grep -E '❌|ERROR|error' <<<"$out" | head -10)"

step "install-windows dry-run"
if command -v pwsh >/dev/null 2>&1; then
  out=$(pwsh -NoProfile -File setup/install-windows.dry-run.ps1 2>&1) && pass || fail "$(grep -E '❌|ERROR|error' <<<"$out" | head -10)"
else
  pass "pwsh not installed, CI covers it"
fi

if [ "$failed" -gt 0 ]; then
  echo "[pre-push] $failed check(s) failed — push blocked. Fix them, or skip once with: git push --no-verify"
  exit 1
fi
echo "[pre-push] all checks passed"
