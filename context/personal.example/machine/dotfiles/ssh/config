# Personal SSH hosts. The installer links this file to ~/.ssh/config.personal, which the shared
# ~/.ssh/config includes. Put hosts that name you, your employer or your servers here.
# Never commit private keys; only host stanzas.

# ─── A separate work account on GitHub ───
# Host github-work
#     HostName github.com
#     User git
#     IdentityFile ~/.ssh/id_ed25519_github_work
#     IdentitiesOnly yes

# ─── A server of yours ───
# Host myserver
#     HostName myserver.example.com
#     User deploy
#     IdentityFile ~/.ssh/id_ed25519_myserver
#     IdentitiesOnly yes
