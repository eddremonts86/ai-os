# Static build for the AI-OS Plans Explorer (apps/plans-explorer/), served by nginx.
#
# Coolify builds this from the REPO ROOT with dockerfile_location=/Dockerfile.plans-explorer
# and base_directory=/. ports_exposes must be 80.
#
# Why the whole repo is the build context and not just apps/plans-explorer/:
# the indexer reads the corpus from `../data/projects/` relative to apps/plans-explorer/
# (build-index.mjs: PROJECTS_DIR = join(ROOT, '..', 'projects')), and plans.json is
# generated, not committed. Copying only the app would give a green build serving an
# empty explorer — 0 plans, every facet blank. `.dockerignore` keeps the context small.
#
# The build is offline: enriched plans own their prose, so the indexer skips the source
# scrape entirely (`skipped=N (enriched plans own their prose)`). No deploy of this image
# depends on problemhunt.pro or reddit.com being reachable or willing.

# ---------- build ----------
FROM node:22-alpine AS build
WORKDIR /repo

# Dependencies first, so a corpus-only change reuses the install layer.
COPY apps/plans-explorer/app/package.json apps/plans-explorer/app/package-lock.json ./apps/plans-explorer/app/
RUN --mount=type=cache,target=/root/.npm \
    cd apps/plans-explorer/app && npm ci --no-audit --no-fund

# The corpus and the app. The corpus is listed first for the same layer-cache reason:
# app source changes far more often than the plans do.
COPY apps/data/projects/ ./apps/data/projects/
COPY apps/plans-explorer/ ./apps/plans-explorer/

# The indexer resolves the repo root by walking up to the CLAUDE.md marker, and this image is a
# deliberate partial copy — the corpus and the app, nothing else — so that marker does not exist
# here and the walk would throw. Name the root explicitly instead of copying an instructions file
# into a web image just to satisfy a search.
ENV AI_OS_ROOT=/repo

# `npm run build` runs prebuild (the indexer) then vue-tsc + vite. Type errors and a
# broken corpus both fail the image rather than shipping quietly.
RUN cd apps/plans-explorer/app && npm run build

# Fail loudly if the corpus did not make it into the context. A container serving an
# explorer with zero plans is the failure mode this whole file exists to prevent, and
# it is indistinguishable from success without this check.
RUN set -eu; \
    plans=$(node -e "const p=require('/repo/apps/plans-explorer/app/public/data/plans.json');console.log(p.length)"); \
    echo "indexed plans: $plans"; \
    [ "$plans" -gt 0 ] || { echo "FATAL: indexer produced 0 plans — is apps/data/projects/ in the build context?" >&2; exit 1; }

# ---------- runtime ----------
FROM nginx:1.27-alpine

RUN rm -rf /usr/share/nginx/html/*
COPY --from=build /repo/apps/plans-explorer/app/dist/ /usr/share/nginx/html/

# The SPA uses hash routing (createWebHashHistory), so deep links never hit nginx as a
# path — but keep the fallback anyway for /assets and any future history-mode switch.
# Cache policy mirrors the landing's Dockerfile: immutable on fingerprinted assets,
# no-cache on the HTML shell and on the generated data, which changes every build.
RUN printf '%s\n' \
  'server {' \
  '  listen 80;' \
  '  server_name _;' \
  '  root /usr/share/nginx/html;' \
  '  index index.html;' \
  '  location = /index.html { add_header Cache-Control "no-cache"; }' \
  '  location /data/ { add_header Cache-Control "no-cache"; }' \
  '  location /assets/ { add_header Cache-Control "public, max-age=31536000, immutable"; }' \
  '  location / { try_files $uri $uri/ /index.html; }' \
  '  add_header X-Content-Type-Options nosniff always;' \
  '  add_header X-Frame-Options DENY always;' \
  '  add_header Referrer-Policy strict-origin-when-cross-origin always;' \
  '  gzip on;' \
  '  gzip_types text/css application/javascript application/json image/svg+xml;' \
  '}' > /etc/nginx/conf.d/default.conf

EXPOSE 80
# Probe the generated data, not just the shell: nginx will happily serve index.html for
# an image whose build produced no plans.json.
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1/data/plans.json >/dev/null 2>&1 || exit 1
