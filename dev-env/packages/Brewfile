# Brewfile — AI-OS dev environment (CORE, always installed)
# Mac only. To install: brew bundle install --file=Brewfile
# Everything optional (GUI apps you rarely open, language runtimes you don't
# use daily, infra CLIs) lives in Brewfile.extras — install-mac.sh only pulls
# it in when run with EXTRAS=1. See Brewfile.extras for the full list.

# ─── Taps ───
tap "hashicorp/tap"  # for terraform (extras)
tap "aws/tap"        # for awscli (extras)

# ─── Core tools ───
brew "git"
brew "gh"                  # GitHub CLI
brew "curl"
brew "jq"
brew "yq"                  # YAML processor — hard dependency of install-mac.sh itself
brew "rsync"
brew "ripgrep"

# ─── Shells ───

# ─── Languages / Runtimes (only what AI-OS itself needs) ───
brew "node"                # Node.js 22+
brew "python@3.11"
brew "uv"                  # modern Python package manager

# ─── Container / AI-OS memory stack ───
brew "docker"
brew "docker-compose"
cask "docker-desktop"       # provides the daemon the docker CLI above talks to
brew "ollama"               # AI-OS memory stack (phase 1) — local embeddings

# ─── Security scanners (aios-security-* skills) ───
brew "gitleaks"            # secrets in code and git history
brew "osv-scanner"         # dependency CVEs (OSV database)
brew "trivy"               # container images, IaC, filesystem CVEs
brew "hadolint"            # Dockerfile lint
brew "semgrep"             # SAST rules (OWASP, TypeScript, React)

# ─── Build / Package managers ───
brew "pnpm"                 # used throughout AI-OS (npm-globals install, apps/)

# ─── Fonts ───

# ─── Terminal (AI-OS default) ───

# ─── Editor ───

# Browser and system-utility GUI apps live in Brewfile.extras: AI-OS does not
# need them, and keeping them here made every install touch unrelated apps.
