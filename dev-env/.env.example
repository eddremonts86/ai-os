# AI-OS memory stack — env template (phase 1, Task 1.4)
#
# Copy to ~/.hermes/.env (or symlink) and source it in your shell:
#   cp dev-env/.env.example ~/.hermes/.env
#   echo 'source ~/.hermes/.env' >> ~/.zshrc
#
# These are the canonical port assignments for the memory stack.
# Change ONLY here, and update docker-compose.yml + graphiti.yaml accordingly.

# FalkorDB (Task 1.3)
FALKORDB_HOST=localhost
FALKORDB_PORT=6390
FALKORDB_WEB_PORT=3300
FALKORDB_URL=redis://localhost:6390

# Ollama (Task 1.6)
OLLAMA_HOST=localhost
OLLAMA_PORT=11500
OLLAMA_URL=http://localhost:11500
OLLAMA_EMBED_MODEL=nomic-embed-text

# codebase-memory-mcp (Task 1.4)
# Single static binary, default TCP port (if exposed at all)
CODEBASE_MEMORY_MCP_PORT=3990

# graphiti MCP (Task 1.2)
# Connects to FalkorDB via FALKORDB_URL
# Needs an LLM for extraction. Default: OpenAI (set below).
# To use Ollama instead, set GRAPHITI_LLM_PROVIDER=ollama
GRAPHITI_LLM_PROVIDER=openai
GRAPHITI_LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY is auto-loaded by graphiti from env

# Memory stack toggle (set to 0 to disable all memory MCPs at boot)
AI_OS_MEMORY_ENABLED=1
