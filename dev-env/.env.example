# AI-OS memory stack endpoint template
#
# Copy to ~/.hermes/.env (or symlink) and source it in your shell:
#   cp dev-env/.env.example ~/.hermes/.env
#   echo 'source ~/.hermes/.env' >> ~/.zshrc
#
# These endpoints are loopback-only and match memory/falkordb/docker-compose.yml.

# FalkorDB
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6390
FALKORDB_URL=redis://127.0.0.1:6390
FALKORDB_WEB=http://127.0.0.1:3300
