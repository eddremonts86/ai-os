# ~/.ssh/config — SSH client configuration
# Template version: copy this file to ~/.ssh/config with 600 permissions.
# Do not commit private keys (id_rsa, id_ed25519); only commit this config.

# ─── Defaults ───
Host *
    # Keep connections alive
    ServerAliveInterval 60
    ServerAliveCountMax 3
    # Use modern key exchange algorithms
    KexAlgorithms curve25519-sha256@libssh.org,diffie-hellman-group-exchange-sha256
    # Use modern ciphers
    Ciphers chacha20-poly1305@openssh.com,aes256-gcm@openssh.com,aes128-gcm@openssh.com
    # Use modern MACs
    MACs hmac-sha2-512-etm@openssh.com,hmac-sha2-256-etm@openssh.com
    # Compression
    Compression yes
    # Add keys to agent
    AddKeysToAgent yes
    # Use specific identity file per host
    # UseKeychain yes  # macOS only (Apple's OpenSSH fork). Uncomment if on
    # macOS and using Keychain for SSH keys -- this keyword is unknown to
    # Windows/Linux OpenSSH and breaks config parsing entirely if left active,
    # since this template is shared across all 3 platforms (install-mac.sh
    # symlinks it, install-windows.ps1 copies it verbatim).
    # Forward agent only to trusted servers
    ForwardAgent no
    # Verbose logging for debugging
    # LogLevel DEBUG3

# ─── GitHub ───
Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519_github
    IdentitiesOnly yes
    # AddKeysToAgent yes
    # UseKeychain yes

# ─── GitHub Work (Schilling) ───
# If you use a separate work account:
# Host github-work
#     HostName github.com
#     User git
#     IdentityFile ~/.ssh/id_ed25519_github_work
#     IdentitiesOnly yes

