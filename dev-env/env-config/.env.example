# =============================================================================
# .env.master.example — PLANTILLA MAESTRA UNIFICADA (sin secretos)
# =============================================================================
# Superset de todas las variables de entorno usadas en los proyectos:
#   · edd-app-template / tanstack_template
#   · edd-remonts-dashboard
#   · hermes-workspace
#   · workspace global OpenClaw/Hetzner/Coolify
#
# USO:  copia este fichero a .env y rellena los valores reales.
#         cp .env.master.example .env
#
# Esta versión NO contiene secretos → es la que puedes versionar/compartir.
# Cada placeholder está en MAYÚSCULAS entre <…>. Las URLs/puertos/modelos por
# defecto se dejan rellenos porque no son secretos.
#
# Convención de conflictos: cuando una variable tenía valores distintos entre
# proyectos, dejo activo el recomendado y listo las demás como comentarios.
#
# ÍNDICE
#   1.  Aplicación
#   2.  Base de datos
#   3.  Autenticación (Better Auth + Clerk)
#   4.  Admin local por defecto
#   5.  LLM en la nube (MiniMax, OpenAI, Anthropic)
#   6.  LLM local (Ollama, llama.cpp, LM Studio)
#   7.  RAG / Embeddings
#   8.  Stack de agentes (OpenClaw, Telegram, open-design)
#   9.  Hermes workspace (proxy Claude Code → MiniMax)
#   10. Infra cloud (Hetzner + Coolify)
#   11. GitHub / Git
#   12. Monitorización (Sentry, Percy)
#   13. Tokens varios (NPM)
# =============================================================================

# ── 1. APLICACIÓN ─────────────────────────────────────────────────────────────
NODE_ENV=development # development | production
PORT=3000
APP_URL=http://localhost:3000 # URL pública base (redirects de auth, webhooks)
# prod:        https://remonts.eduardoinerarte.dk
# fleet local: https://profile.eduardoinerarte.local
VITE_API_URL= # base absoluta de la API; vacío = mismo origen
VITE_DEFAULT_LOCALE=en # idioma inicial de la UI: en | es | da
TZ=Europe/Madrid # zona horaria del contenedor (logs y cron)

# ── 2. BASE DE DATOS ──────────────────────────────────────────────────────────
# DB de desarrollo local. El nombre de la base cambia según el proyecto:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/edd_app_template
# Alternativas (mismo usuario/clave, distinto nombre de base):
#   …/edd_remonts_dashboard   (edd-remonts-dashboard)
#   …/tanstack_template       (plantilla tanstack original)

# Variante en puerto 5433 (workspace global, evita choque con Postgres del sistema)
LOCAL_DATABASE_URL=postgres://postgres:postgres@localhost:5433/tanstack_template

# DB de producción — gestionada por Coolify, hostname interno de su red
PROD_DATABASE_URL=postgres://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>

# Partes sueltas de Postgres (docker-compose prod / fleet local)
POSTGRES_USER=<POSTGRES_USER> # ej: remonts · remontsapp · hermes
POSTGRES_PASSWORD=<POSTGRES_PASSWORD> # genera una fuerte en prod
POSTGRES_DB=<POSTGRES_DB> # ej: edd_remonts_dashboard · remonts_prod · hermes

# Clave AES-256-GCM del módulo "database admin" (cifra las contraseñas de los
# perfiles de conexión). ≥16 chars en dev, ≥32 recomendado en prod.
DB_CONFIG_SECRET=<RANDOM_32_CHARS_MIN>

# ── 3. AUTENTICACIÓN ──────────────────────────────────────────────────────────
# AUTH_MODE controla el proveedor activo:
#   hybrid → Better Auth (principal) + Clerk (opcional encima)
#   clerk  → solo Clerk
#   local  → solo Better Auth
AUTH_MODE=hybrid
VITE_AUTH_MODE=hybrid # espejo cliente — debe coincidir con AUTH_MODE

# Better Auth (capa principal). Genera el secret con: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000 # debe coincidir con APP_URL
VITE_BETTER_AUTH_URL=http://localhost:3000 # espejo cliente (se hornea en el bundle de Vite)
BETTER_AUTH_SECRET=<OPENSSL_RAND_BASE64_32>
PROD_BETTER_AUTH_SECRET=<OPENSSL_RAND_BASE64_32_PROD>

# Clerk (solo activo cuando SHOULD_USE_CLERK_PROVIDER=true).
# Claves en dashboard.clerk.com → API Keys.
SHOULD_USE_CLERK_PROVIDER=true
VITE_CLERK_PUBLISHABLE_KEY=<pk_test_o_pk_live_...>
CLERK_SECRET_KEY=<sk_test_o_sk_live_...>

# ── 4. ADMIN LOCAL POR DEFECTO ────────────────────────────────────────────────
# Sembrado por `pnpm db:seed:admin` tras las migraciones.
# ⚠ En PROD rellena valores propios: si quedan vacíos, seed-admin cae a defaults
#   públicos y crearía un admin adivinable.
DEFAULT_ADMIN_EMAIL=edd_admin@local.com # fleet local usa: admin@local.test
DEFAULT_ADMIN_PASSWORD=Passw0rd!234 # fleet local usa: LocalAdmin!1234

# ── 5. LLM EN LA NUBE ─────────────────────────────────────────────────────────
# MiniMax — LLM principal (API compatible con OpenAI).
#   Endpoint internacional: https://api.minimaxi.chat/v1
#   Endpoint China:         https://api.minimax.chat/v1
MINIMAX_API_KEY=<MINIMAX_API_KEY>
MINIMAX_BASE_URL=https://api.minimaxi.chat/v1
MINIMAX_MODEL=MiniMax-M3
# Otros nombres de modelo vistos: abab6.5-chat · MiniMax-M2.7 · MiniMax-M1

# OpenAI — fallback opcional (deja la key vacía para desactivar)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic — fallback opcional en la nube (deja la key vacía para desactivar).
# OJO: la sección 9 (Hermes) reusa ANTHROPIC_BASE_URL para apuntar a MiniMax.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Key genérica de fallback (se usa cuando falta la específica del proveedor)
AI_API_KEY=

# Espejos cliente (Vite) de las URLs de los proveedores cloud
VITE_AI_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_AI_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
VITE_AI_MINIMAX_BASE_URL=https://api.minimaxi.chat/v1

# ── 6. LLM LOCAL ──────────────────────────────────────────────────────────────
# AI_API_BASE_URL es la variable unificada — cámbiala para conmutar todos los
# proveedores locales de golpe. Arranca los contenedores con:
#   docker compose --profile ai up -d
#   Ollama:    http://localhost:11435/v1   (legacy: 11434)
#   llama.cpp: http://localhost:8080/v1
#   LM Studio: http://localhost:1234/v1
AI_API_BASE_URL=http://localhost:11435/v1

AI_OLLAMA_BASE_URL=http://localhost:11435/v1
AI_LLAMA_CPP_BASE_URL=http://localhost:8080/v1
AI_LMSTUDIO_BASE_URL=http://localhost:1234/v1
AI_OLLAMA_MODEL=qwen3.5:2b
AI_LLAMA_CPP_MODEL=qwen3.5-2b
AI_LMSTUDIO_MODEL=qwen3.5-2b # valor antiguo en algunos proyectos: llama3.2
OLLAMA_MODEL=llama3.2 # alias legacy de modelo Ollama
OLLAMA_ORIGINS=*
AI_BASE_URL_INTERNAL= # base URL interna (solo red del clúster) del gateway AI

# Alias legacy — replica AI_API_BASE_URL para compatibilidad hacia atrás
VITE_AI_BASE_URL=http://localhost:11435/v1

# Espejos cliente (Vite) de los proveedores self-hosted
VITE_AI_OLLAMA_BASE_URL=
VITE_AI_LLAMA_CPP_BASE_URL=
VITE_AI_LMSTUDIO_BASE_URL=

# ── 7. RAG / EMBEDDINGS ───────────────────────────────────────────────────────
CHROMADB_URL=http://localhost:8000 # vector store (prod en docker: http://chromadb:8000)
AI_EMBEDDING_URL=http://localhost:1234/v1/embeddings
AI_EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
AI_EMBEDDING_TIMEOUT_MS=30000 # timeout (ms) de las llamadas de embeddings

# ── 8. STACK DE AGENTES (OpenClaw / Telegram / open-design) ──────────────────
# OpenClaw — gateway de IA self-hosted en Docker. UI: http://127.0.0.1:18789
# Generar token:  openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=<OPENSSL_RAND_HEX_32>

# Telegram — crea el bot en t.me/BotFather y pega el token.
TELEGRAM_BOT_TOKEN=<TELEGRAM_BOT_TOKEN>
TELEGRAM_ALLOWED_USERS= # chat_ids permitidos (coma-separados). Vacío = cualquiera
TELEGRAM_POLLING=true # true = long polling (sin dominio) · false = webhooks

# open-design daemon (tools/open-design)
OD_PORT=7456
OD_API_TOKEN=<OPENSSL_RAND_HEX_32> # requerido si OD_BIND_HOST != 127.0.0.1

# ── 9. HERMES WORKSPACE (proxy Claude Code → MiniMax) ────────────────────────
HERMES_MODEL=MiniMax-M3
HERMES_UID=1000 # `id -u` en Linux/macOS para evitar líos de permisos
HERMES_GID=1000 # `id -g`
HERMES_PROJECTS_PATH=./projects
API_TIMEOUT_MS=3000000 # timeout de la API en ms (50 min)
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 # corta telemetría no esencial de Claude Code

# ⚠ Bloque de override Anthropic→MiniMax. Descoméntalo SOLO si quieres que
#   Claude Code use MiniMax como backend. Sobrescribe ANTHROPIC_BASE_URL de la
#   sección 5. ANTHROPIC_AUTH_TOKEN debe valer lo mismo que MINIMAX_API_KEY.
# ANTHROPIC_BASE_URL=https://api.minimax.io/anthropic
# ANTHROPIC_AUTH_TOKEN=<MINIMAX_API_KEY>
# ANTHROPIC_MODEL=MiniMax-M3
# ANTHROPIC_DEFAULT_SONNET_MODEL=MiniMax-M3
# ANTHROPIC_DEFAULT_OPUS_MODEL=MiniMax-M3
# ANTHROPIC_DEFAULT_HAIKU_MODEL=MiniMax-M3

# Modelo alternativo: Claude real vía OpenRouter (opcional).
# OPENROUTER_API_KEY=
# HERMES_MODEL=anthropic/claude-sonnet-4.6
# HERMES_MODEL=anthropic/claude-opus-4.7
# HERMES_MODEL=anthropic/claude-haiku-4.5-20251001

# Producción de Hermes (perfil `prod` → Traefik + TLS). Rellena al desplegar.
DOMAIN= # dominio público apuntando a la IP del VPS (A/AAAA)
ACME_EMAIL= # email para Let's Encrypt (avisos de expiración)

# ── 10. INFRA CLOUD (Hetzner + Coolify) ──────────────────────────────────────
# Cuenta Hetzner Cloud (accounts.hetzner.com)
HETZNER_USER=<HETZNER_EMAIL>
HETZNER_PASSWORD=<HETZNER_PASSWORD>
# API token (console.hetzner.cloud → Project → Security → API Tokens, Read & Write)
HETZNER_API_TOKEN=<HETZNER_API_TOKEN>
# Spec del servidor (scripts de aprovisionamiento)
HETZNER_PROJECT=username-01
HETZNER_SERVER_NAME=conductor-01
HETZNER_SERVER_TYPE=cax21 # ARM64, 4 vCPU / 8 GB RAM
HETZNER_LOCATION=fsn1 # Falkenstein, Alemania
HETZNER_IMAGE=ubuntu-24.04
# Servidor activo (conductor-01)
CONDUCTOR_IP=<SERVER_IP>
CONDUCTOR_SERVER_ID=<SERVER_ID>
CONDUCTOR_SSH_KEY=~/.ssh/id_ed25519_conductor
CONDUCTOR_HOST=<SERVER_HOSTNAME>
# DNS: *.eduardoinerarte.dk → IP del VPS como wildcard en GoDaddy.

# Coolify — PaaS self-hosted. Token Sanctum, con el formato `<id>|<hash>`.
#
# ⚠️ El token contiene un `|`. NO leas este fichero con `source`: bash interpreta el `|`
#    como tubería, la variable se queda solo con el id, y la API responde 401 — idéntico
#    a un token revocado, que es el diagnóstico equivocado al que lleva. Léelo con awk:
#      T=$(awk -F= '/^COOLIFY_API_TOKEN=/{sub(/^[^=]*=/,""); print; exit}' "$ENV_FILE")
COOLIFY_API_URL=http://<SERVER_IP>:8000
COOLIFY_API_TOKEN=<COOLIFY_API_TOKEN>
# UUIDs de recursos (project → server → app)
#
# ⚠️ COOLIFY_APP_UUID es AMBIGUO por diseño: un solo servidor aloja muchas aplicaciones y
#    esta variable solo puede contener una. Apunta a la que se aprovisionó por última vez,
#    no a la que estés desplegando. Usarla a ciegas escribe variables o redespliega en la
#    aplicación equivocada — y Coolify devuelve 200 igualmente, sin ningún error.
#
#    Resuelve siempre el uuid por NOMBRE contra la API en vivo antes de escribir o desplegar:
#      curl -fsS -H "Authorization: Bearer $COOLIFY_API_TOKEN" -H "Accept: application/json" \
#        "$COOLIFY_API_URL/api/v1/applications" \
#      | python3 -c "import json,sys; [print(a['uuid'], a['name'], a.get('fqdn')) for a in json.load(sys.stdin)]"
#
#    Contrasta `name` y confirma que `fqdn` es el host esperado. Los uuid cambian si la
#    aplicación se recrea, así que no los caches en ningún sitio.
#
#    No hay `COOLIFY_DB_UUID`. Una base de datos que vive dentro del compose de su
#    aplicación no es un recurso de Coolify y no tiene uuid; una que sí lo es se resuelve
#    por nombre igual que las aplicaciones, contra `/api/v1/databases`.
COOLIFY_PROJECT_UUID=<COOLIFY_PROJECT_UUID>
COOLIFY_SERVER_UUID=<COOLIFY_SERVER_UUID>
COOLIFY_APP_UUID=<COOLIFY_APP_UUID>
COOLIFY_APP_UUID_PLANS_EXPLORER=<COOLIFY_APP_UUID_PLANS_EXPLORER>
COOLIFY_GITHUB_DEPLOY_KEY_UUID=<COOLIFY_DEPLOY_KEY_UUID>

# ── 11. GITHUB / GIT ──────────────────────────────────────────────────────────
# PAT clásico (github.com/settings/tokens → scopes: repo, workflow)
GH_TOKEN=<ghp_...>
GIT_HUB=<ghp_..._full_access> # alias con acceso total (token distinto del de arriba)
GHCR_READ_TOKEN=<ghp_..._read_packages> # scope read:packages para `make sync-image`
GITHUB_USER=userid-dk
# Identidad git del agente openclaw
GIT_AUTHOR_NAME="Lúa (openClaw)"
GIT_AUTHOR_EMAIL=openclaw@userid.dk
WHATSAPP_MY_NUMBER=<+CC_NUMERO> # notificaciones del agente

# ── 12. MONITORIZACIÓN ────────────────────────────────────────────────────────
VITE_SENTRY_DSN=<SENTRY_DSN> # vacío = desactiva tracking. sentry.io → Client Keys
PERCY_TOKEN=<PERCY_TOKEN> # visual testing. percy.io → Project → token

# ── 13. TOKENS VARIOS ─────────────────────────────────────────────────────────
NPM_TOKEN=<npm_...> # publicación/instalación de paquetes privados
