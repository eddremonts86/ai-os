# =============================================================================
# AI-OS environment template (no secrets, safe to commit)
# =============================================================================
# The variables AI-OS itself, its skills and its scripts read. Copy it to
# dev-env/env-config/.env (git-ignored) and fill in the <PLACEHOLDERS>; the
# defaults that are not secret (URLs, ports, models) are filled in already.
#
#   cp dev-env/env-config/.env.example dev-env/env-config/.env
#
# An app's own variables (database, auth, admin seed, UI) belong in that app's
# .env.example, not here.
#
#   1. LLM router (llm/router.mjs)
#   2. Cloud model keys used by skills
#   3. Local agent (opencode)
#   4. Hosting: Hetzner + Coolify
#   5. GitHub and npm
# =============================================================================

# ── 1. LLM router (llm/router.mjs, llm/README.md) ────────────────────────────
AI_LLM_PROVIDER=local # local | minimax
# Native Ollama (brew + launchd `ai.os.ollama`), shared with the memory stack.
AI_OLLAMA_NATIVE_BASE_URL=http://localhost:11500/v1
AI_OLLAMA_NATIVE_MODEL=gemma3:12b # no "thinking" model: Ollama serves one request at a time
# MiniMax (OpenAI-compatible). International endpoint below; China: https://api.minimax.chat/v1
MINIMAX_API_KEY=<MINIMAX_API_KEY>
MINIMAX_BASE_URL=https://api.minimaxi.chat/v1
MINIMAX_MODEL=MiniMax-M3

# ── 2. Cloud model keys used by skills (leave empty to disable) ──────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── 3. Local agent (opencode, llm/launchd/install-opencode.sh) ───────────────
# Without a password any local process that reaches :4096 can point it at any
# folder with --auto. Generate one: openssl rand -hex 32
OPENCODE_SERVER_PASSWORD=<OPENSSL_RAND_HEX_32>

# ── 4. Hosting: Hetzner + Coolify (hetzner-cloud-cli, coolify-deploy) ────────
# console.hetzner.cloud → Project → Security → API Tokens (Read & Write)
HETZNER_API_TOKEN=<HETZNER_API_TOKEN>
# SSH key for the production server
CONDUCTOR_SSH_KEY=~/.ssh/id_ed25519_<server>

# Coolify Sanctum token, formatted `<id>|<hash>`.
# Do NOT `source` this file: bash reads the `|` as a pipe, keeps only the id, and
# the API answers 401, which looks exactly like a revoked token. Read it with awk:
#   T=$(awk -F= '/^COOLIFY_API_TOKEN=/{sub(/^[^=]*=/,""); print; exit}' "$ENV_FILE")
COOLIFY_API_URL=http://<SERVER_IP>:8000
COOLIFY_API_TOKEN=<COOLIFY_API_TOKEN>
# COOLIFY_APP_UUID is ambiguous by design: one server hosts many apps and this holds
# one, the last one provisioned. Writing or deploying with it blindly hits the wrong
# app and Coolify still answers 200. Resolve the uuid by NAME against the live API
# first and confirm its fqdn:
#   curl -fsS -H "Authorization: Bearer $COOLIFY_API_TOKEN" -H "Accept: application/json" \
#     "$COOLIFY_API_URL/api/v1/applications" \
#   | python3 -c "import json,sys; [print(a['uuid'], a['name'], a.get('fqdn')) for a in json.load(sys.stdin)]"
COOLIFY_APP_UUID=<COOLIFY_APP_UUID>
COOLIFY_GITHUB_DEPLOY_KEY_UUID=<COOLIFY_DEPLOY_KEY_UUID>

# ── 5. GitHub and npm ────────────────────────────────────────────────────────
GH_TOKEN=<ghp_...> # github.com/settings/tokens → repo, workflow
NPM_TOKEN=<npm_...> # publishing (npm-package-publishing skill)
