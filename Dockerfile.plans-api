# Read-only REST API over the AI-OS plans corpus (apps/plans-api/), for external
# consumers such as builderhunt.
#
# Coolify builds this from the REPO ROOT with dockerfile_location=/Dockerfile.plans-api
# and base_directory=/. ports_exposes must be 8080.
#
# PLANS_API_TOKEN is required — the server refuses to start without it (server.mjs).
# Set it as a Coolify secret before the first deploy.
#
# Why the whole repo is the build context and not just apps/plans-api/: the API reads
# plans.json + rankings.json + meta.json + documents/<id>.json from
# apps/plans-explorer/app/public/data/, which is generated by that app's indexer, not
# committed — same reason Dockerfile.plans-explorer copies apps/data/projects/ into its
# own build. This stage runs the same indexer (`npm run index`), not the SPA's
# `npm run build`: plans-api needs the generated data/, never the built dist/.

# ---------- build (generate the corpus plans-explorer's indexer produces) ----------
FROM node:22-alpine AS build
WORKDIR /repo

COPY apps/plans-explorer/app/package.json apps/plans-explorer/app/package-lock.json ./apps/plans-explorer/app/
RUN --mount=type=cache,target=/root/.npm \
    cd apps/plans-explorer/app && npm ci --no-audit --no-fund

COPY apps/data/projects/ ./apps/data/projects/
COPY apps/plans-explorer/ ./apps/plans-explorer/

# See Dockerfile.plans-explorer: the indexer resolves the repo root by walking up to the
# CLAUDE.md marker, which does not exist in this partial copy.
ENV AI_OS_ROOT=/repo
RUN cd apps/plans-explorer/app && npm run index

# Fail loudly if the corpus did not make it into the context — an API answering
# `{"total":0}` is indistinguishable from success without this check.
RUN set -eu; \
    plans=$(node -e "const p=require('/repo/apps/plans-explorer/app/public/data/plans.json');console.log(p.length)"); \
    echo "indexed plans: $plans"; \
    [ "$plans" -gt 0 ] || { echo "FATAL: indexer produced 0 plans — is apps/data/projects/ in the build context?" >&2; exit 1; }

# ---------- runtime ----------
# Kept as siblings under /repo/apps/, exactly like the source tree, so
# lib/data.js's own relative resolution (apps/plans-api/lib -> apps/plans-explorer/...)
# needs no override.
FROM node:22-alpine
WORKDIR /repo/apps/plans-api

COPY apps/plans-api/package.json apps/plans-api/package-lock.json ./
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --no-audit --no-fund

COPY apps/plans-api/ ./
COPY --from=build /repo/apps/plans-explorer/app/public/data/ /repo/apps/plans-explorer/app/public/data/

# Drop root. The service only reads the corpus baked in above and answers HTTP.
USER node

ENV PLANS_API_PORT=8080 PLANS_API_HOST=0.0.0.0 NODE_ENV=production
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/health >/dev/null 2>&1 || exit 1

CMD ["node", "server.mjs"]
