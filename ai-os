#!/usr/bin/env bash
# ai-os — top-level dispatcher for the AI-OS CLI.
#
# Routes the first argument to the right subcommand script under $AI_OS_ROOT/.
# Without this, `ai-os memory status` would fail because the symlink
# ~/.local/bin/ai-os historically pointed straight at memory/ai-os-memory.sh
# (which only knows its own subcommands, not the `memory` keyword).
#
# Subcommand groups:
#   memory  →  memory/ai-os-memory.sh          (status, browse, reindex, bootstrap, ...)
#   loop    →  memory/ai-os-loop.sh            (Spec → Verifier → Environment)
#   bootstrap [...]   →  setup/ai-os-bootstrap.sh   (on-demand full-stack + auto-index)
#   health [...]      →  setup/ai-os-health.py      (functional checks of the running system)
#   stats [...]       →  setup/ai-os-stats.py       (published counts, --check / --write)
#   update [...]      →  setup/ai-os-update.py      (pinned vs upstream, verified upgrades)
#   backup [...]      →  setup/ai-os-backup.py      (snapshot + restore check of what cannot be rebuilt)

set -euo pipefail

# Resolve the actual AI-OS root, following symlinks (the wrapper at
# ~/.local/bin/ai-os is a symlink to this file, so BASH_SOURCE alone would
# resolve to ~/.local/bin/ and exec the wrong path).
_SOURCE="${BASH_SOURCE[0]:-$0}"
while [ -L "$_SOURCE" ]; do
  _DIR="$(cd -P "$(dirname "$_SOURCE")" && pwd)"
  _SOURCE="$(readlink "$_SOURCE")"
  [[ "$_SOURCE" != /* ]] && _SOURCE="$_DIR/$_SOURCE"
done
AI_OS_ROOT="$(cd -P "$(dirname "$_SOURCE")" && pwd)"

usage() {
  cat <<EOF
ai-os — AI-OS top-level CLI

Usage:
  ai-os memory <subcommand> [args]    Memory stack (status, browse, reindex, bootstrap, ...)
  ai-os loop   <subcommand> [args]    Loop runner (start, status, ...)
  ai-os plans  <subcommand> [args]     Plan documents (check, format, test, enrich)
  ai-os llm    <subcommand> [args]    Local/cloud chat router (ask, test)
  ai-os bootstrap [--refresh]         First-time / on-demand full-stack setup + auto-index
  ai-os health [--json|--notify]      Functional checks of the running system (graph, MCP, tokens, CI…)
  ai-os stats [--check|--write]       Published counts (skills, MCP, …) computed from the repo
  ai-os update [--apply COMPONENT]    Pinned vs upstream versions; --apply bumps one, verifies, rolls back
  ai-os backup [--verify|--show-key]  Snapshot graph + .env + Claude memory, encrypted copy to iCloud Drive

Run \`ai-os memory help\`, \`ai-os loop help\`, \`ai-os plans help\` or \`ai-os llm\` (no args) for the subcommand list.
EOF
}

case "${1:-}" in
  memory)
    shift
    exec bash "$AI_OS_ROOT/memory/ai-os-memory.sh" "$@"
    ;;
  llm)
    shift
    exec bash "$AI_OS_ROOT/llm/ai-os-llm.sh" "$@"
    ;;
  loop)
    shift
    exec bash "$AI_OS_ROOT/memory/ai-os-loop.sh" "$@"
    ;;
  plans)
    shift
    if [ -z "${PLANSMITH_ROOT:-}" ]; then
      echo "ai-os: plans moved to the plansmith repo. Set PLANSMITH_ROOT=/path/to/plansmith" >&2
      exit 1
    fi
    exec bash "$PLANSMITH_ROOT/apps/data/tools/plan-format/ai-os-plans.sh" "$@"
    ;;
  bootstrap)
    shift
    exec bash "$AI_OS_ROOT/setup/ai-os-bootstrap.sh" "$@"
    ;;
  backup)
    shift
    py="$HOME/.ai-os/venv/bin/python"   # cryptography lives in the AI-OS venv
    [ -x "$py" ] || py=python3
    exec "$py" "$AI_OS_ROOT/setup/ai-os-backup.py" "$@"
    ;;
  update)
    shift
    exec python3 "$AI_OS_ROOT/setup/ai-os-update.py" "$@"
    ;;
  stats)
    shift
    exec python3 "$AI_OS_ROOT/setup/ai-os-stats.py" "$@"
    ;;
  health)
    shift
    py="$HOME/.ai-os/venv/bin/python"
    [ -x "$py" ] || py=python3
    exec "$py" "$AI_OS_ROOT/setup/ai-os-health.py" "$@"
    ;;
  -h|--help|help|"")
    usage
    ;;
  *)
    echo "ai-os: unknown command: $1" >&2
    echo "" >&2
    usage >&2
    exit 1
    ;;
esac
