# syntax=docker/dockerfile:1
# Standalone Graphiti MCP Server Image — MINIMAL variant (AI-OS custom build, 2026-07-13)
#
# Same as the upstream Dockerfile.standalone, but skips the `providers` and
# `azure` optional extras (anthropic, google-genai, groq, voyageai,
# sentence-transformers, azure-identity). None of those are needed for
# AI-OS's setup: the LLM provider is MiniMax via the base 'openai' client's
# custom api_url support (added upstream after v1.0.2 was cut — this is the
# whole reason for building from source instead of using the pinned image),
# and the embedder is local Ollama, also via the base 'openai' client.
#
# This matters because `--extra providers` drags in sentence-transformers,
# which pulls the full PyTorch + CUDA wheel set (~3GB) that is completely
# unused here — a huge, pointless download avoided by this trimmed build.
FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

ADD https://astral.sh/uv/install.sh /uv-installer.sh
RUN sh /uv-installer.sh && rm /uv-installer.sh

ENV PATH="/root/.local/bin:${PATH}"

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never \
    MCP_SERVER_HOST="0.0.0.0" \
    PYTHONUNBUFFERED=1

WORKDIR /app/mcp

ARG GRAPHITI_CORE_VERSION=0.29.2

COPY pyproject.toml uv.lock ./

RUN sed -i '/\[tool\.uv\.sources\]/,/graphiti-core/d' pyproject.toml && \
    sed -i "s/graphiti-core\[falkordb\][>=]\+[0-9]\+\.[0-9]\+\.[0-9]\+/graphiti-core[neo4j,falkordb]==${GRAPHITI_CORE_VERSION}/" pyproject.toml && \
    echo "Regenerating lock file for PyPI graphiti-core..." && \
    rm -f uv.lock && \
    uv lock

# MINIMAL: base deps only (openai client + neo4j/falkordb drivers) — no
# anthropic/gemini/groq/voyageai/sentence-transformers/azure extras.
RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --no-group dev

RUN echo "${GRAPHITI_CORE_VERSION}" > /app/mcp/.graphiti-core-version

# AI-OS patch (2026-07-13): strip <think>...</think> reasoning blocks that
# MiniMax-M2/M3 always prepend to LLM responses — see patches/strip_think_tags.py
# for the full rationale. graphiti-core is pulled from PyPI above (not part of
# this monorepo checkout), so the patch runs against the installed .venv copy.
COPY patches/strip_think_tags.py /tmp/strip_think_tags.py
RUN uv run --no-sync python3 /tmp/strip_think_tags.py && rm /tmp/strip_think_tags.py

COPY main.py ./
COPY src/ ./src/
COPY config/ ./config/

RUN mkdir -p /var/log/graphiti

ARG MCP_SERVER_VERSION=1.0.2
ARG BUILD_DATE
ARG VCS_REF
LABEL org.opencontainers.image.title="Graphiti MCP Server (Standalone, AI-OS minimal build)" \
      org.opencontainers.image.description="Standalone Graphiti MCP server, minimal deps (no torch/cuda), MiniMax-compatible base_url support" \
      org.opencontainers.image.version="${MCP_SERVER_VERSION}" \
      org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.revision="${VCS_REF}" \
      org.opencontainers.image.vendor="AI-OS (custom build from getzep/graphiti main)" \
      org.opencontainers.image.source="https://github.com/getzep/graphiti" \
      graphiti.core.version="${GRAPHITI_CORE_VERSION}"

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

CMD ["uv", "run", "--no-sync", "main.py"]
