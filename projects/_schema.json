{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eddremonts86/ai-os/projects/_schema.json",
  "title": "AI-OS plan document contract",
  "version": "1.0.0",
  "description": "Machine-readable contract for the plan documents under projects/<id>-<slug>/.",
  "statusLifecycle": {
    "description": "A plan advances one step at a time and never skips.",
    "order": [
      "draft",
      "enriched",
      "humanized",
      "web-ready"
    ],
    "meaning": {
      "draft": "Captured by the scraper. Metadata is real; prose is only the source problem.",
      "enriched": "An agent wrote real per-plan content for every varying section.",
      "humanized": "Prose passed the humanizer skill.",
      "web-ready": "Passed every gate rule below. Only `ai-os plans check` may set this."
    }
  },
  "frontmatter": {
    "required": [
      "id",
      "slug",
      "title",
      "status",
      "source",
      "category",
      "date"
    ],
    "optional": [
      "tags",
      "country",
      "wtp",
      "scores",
      "tech",
      "diagram"
    ],
    "fields": {
      "id": {
        "type": "string",
        "pattern": "^\\d{3}$"
      },
      "slug": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "title": {
        "type": "string",
        "minLength": 8,
        "note": "Plain text. No markdown, no trailing period."
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "enriched",
          "humanized",
          "web-ready"
        ]
      },
      "source": {
        "type": "object",
        "required": [
          "name",
          "url"
        ],
        "fields": {
          "name": {
            "type": "string",
            "enum": [
              "ProblemHunt",
              "Reddit",
              "manual"
            ]
          },
          "url": {
            "type": "string",
            "pattern": "^https?://"
          },
          "captured": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      },
      "category": {
        "type": "string",
        "pattern": "^[a-z][a-z-]*$"
      },
      "date": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "country": {
        "type": "string"
      },
      "wtp": {
        "type": "object",
        "note": "Only when the source states one. Absent beats invented.",
        "fields": {
          "raw": {
            "type": "string"
          },
          "currency": {
            "type": "string"
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "period": {
            "type": "string",
            "enum": [
              "month",
              "year",
              "week",
              "one-shot"
            ]
          },
          "mrrMid": {
            "type": "number"
          }
        }
      },
      "scores": {
        "type": "object",
        "fields": {
          "money": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "learn": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "fun": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          }
        }
      },
      "tech": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "note": "Chosen FOR THIS PROBLEM."
      },
      "diagram": {
        "type": "string"
      }
    }
  },
  "documents": {
    "SPEC.md": {
      "required": [
        "Problem",
        "Objective",
        "Target Users",
        "MVP Scope",
        "Constraints"
      ],
      "optional": [
        "Design Direction",
        "Out of Scope"
      ],
      "varyingSections": [
        "Problem",
        "Objective",
        "Target Users",
        "MVP Scope",
        "Constraints"
      ]
    },
    "PRODUCT.md": {
      "required": [
        "Value Proposition",
        "Target Users",
        "Jobs To Be Done",
        "Success Metrics"
      ],
      "optional": [
        "Pricing & Monetization",
        "Competitive Landscape",
        "Risks & Open Questions"
      ],
      "varyingSections": [
        "Value Proposition",
        "Target Users",
        "Jobs To Be Done",
        "Success Metrics",
        "Competitive Landscape",
        "Risks & Open Questions"
      ]
    },
    "PLAN.md": {
      "required": [
        "Tech Stack",
        "Architecture",
        "Milestones",
        "Risks"
      ],
      "optional": [
        "Data Model",
        "Integrations"
      ],
      "varyingSections": [
        "Tech Stack",
        "Architecture",
        "Milestones",
        "Risks"
      ]
    },
    "DESIGN.md": {
      "required": [],
      "optional": [],
      "note": "Free-form. Gate only checks text hygiene."
    },
    "TASKS.md": {
      "required": [
        "Phase 0: Scaffold",
        "Phase 1: Core",
        "Phase 2: Deploy"
      ],
      "optional": [],
      "varyingSections": [
        "Phase 0: Scaffold",
        "Phase 1: Core"
      ]
    }
  },
  "gate": {
    "description": "Rules `ai-os plans check` enforces.",
    "rules": [
      {
        "id": "frontmatter-present",
        "severity": "error",
        "rule": "Every document opens with YAML frontmatter carrying the required fields."
      },
      {
        "id": "no-placeholder-text",
        "severity": "error",
        "rule": "No bracketed placeholder survives.",
        "patterns": [
          "\\[Usuario primario\\]",
          "\\[Usuario secundario\\]",
          "\\[Placeholder\\]",
          "\\[TODO\\]",
          "_Pendiente de an\u00e1lisis manual\\._",
          "descripci\u00f3n del usuario principal"
        ]
      },
      {
        "id": "no-template-clone",
        "severity": "error",
        "rule": "varyingSections not byte-identical across more than maxIdenticalRatio of plans.",
        "maxIdenticalRatio": 0.02
      },
      {
        "id": "sections-written",
        "severity": "error",
        "rule": "No varying section is still the unwritten marker.",
        "marker": "_Not written yet"
      },
      {
        "id": "problem-substantive",
        "severity": "error",
        "rule": "SPEC Problem at least minProblemChars and not just a country.",
        "minProblemChars": 120
      },
      {
        "id": "no-html-in-prose",
        "severity": "error",
        "rule": "No HTML entities, tags or comments in any document body."
      },
      {
        "id": "no-zero-width",
        "severity": "error",
        "rule": "No zero-width characters."
      },
      {
        "id": "english-headings",
        "severity": "error",
        "rule": "Section headings match the schema, which is English."
      },
      {
        "id": "no-bare-long-url",
        "severity": "warn",
        "rule": "No bare URL longer than maxBareUrlChars.",
        "maxBareUrlChars": 100
      },
      {
        "id": "heading-depth",
        "severity": "warn",
        "rule": "Headings never skip a level."
      },
      {
        "id": "tech-not-default",
        "severity": "warn",
        "rule": "frontmatter.tech, when present, is not the legacy global default.",
        "legacyDefault": [
          "React",
          "TypeScript",
          "Node.js API (TanStack Start)",
          "SQLite con Drizzle ORM",
          "Coolify",
          "Docker"
        ]
      }
    ]
  }
}
