# nginx vhost for the AI-OS landing (site/) served statically on a Hetzner VPS.
#
# This is an EXAMPLE, version-controlled so the server config is auditable.
# Copy to the server, replace the placeholders, enable, and reload:
#
#   sudo cp ai-os.conf.example /etc/nginx/sites-available/ai-os.conf
#   sudo sed -i 's/REPLACE_HOSTNAME/ai-os.example.com/; s/REPLACE_WILDCARD/example.com/' \
#     /etc/nginx/sites-available/ai-os.conf
#   sudo ln -sf /etc/nginx/sites-available/ai-os.conf /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# The `root` below MUST equal the HETZNER_DEPLOY_PATH GitHub secret.

server {
    listen 80;
    listen [::]:80;
    server_name REPLACE_HOSTNAME;
    # Redirect all HTTP to HTTPS.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name REPLACE_HOSTNAME;

    # Reuse the existing wildcard cert (adjust if using a per-host cert).
    ssl_certificate     /etc/letsencrypt/live/REPLACE_WILDCARD/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/REPLACE_WILDCARD/privkey.pem;

    # Must match HETZNER_DEPLOY_PATH. Keep this directory DEDICATED to ai-os:
    # the deploy uses `rsync --delete`, so anything else here would be removed.
    root /var/www/ai-os;
    index index.html;

    # Single static page; fall back to index.html.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Security headers.
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    # Compression.
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript image/svg+xml application/json;

    # HTML: always revalidate so deploys show up immediately.
    location = /index.html {
        add_header Cache-Control "no-cache";
    }
}
