# The submission API (apps/submission-api), the plans product's only write path.
#
# Coolify builds this from the REPO ROOT with dockerfile_location=/Dockerfile.submission-api
# and base_directory=/. ports_exposes must be 8080.
#
# No build stage and no `npm ci`: the service has zero dependencies, so the image is node plus
# two files. That is not minimalism for its own sake — this container holds a GitHub token, and
# every dependency it does not have is one that cannot be compromised into reaching it.
#
# The whole repo is not copied. Only the service and the one file it reads.

FROM node:22-alpine

WORKDIR /app

# The contract the API validates against. Copied rather than vendored so the running service
# and the gate can never disagree about what a usable submission is.
COPY apps/data/projects/_schema.json ./apps/data/projects/_schema.json
COPY apps/submission-api/server.mjs ./apps/submission-api/server.mjs

# Drop root. The service reads two files and makes outbound HTTPS calls; it has no reason to
# be able to write anything.
USER node

ENV PORT=8080 NODE_ENV=production
EXPOSE 8080

# Liveness only: /health answered 200. Deliberately NOT `"configured":true`.
#
# It used to assert configured, and that was wrong in a way only a deploy revealed. Coolify will
# not route to an unhealthy container, so a container missing its token never became reachable —
# Traefik answered `no available server` and /health could not be read to find out why. The check
# meant to make misconfiguration visible made it invisible.
#
# The distinction the original comment was reaching for still holds and still lives somewhere:
# `configured:false` is asserted from OUTSIDE, by the deploy workflow, which fails the run on it.
# That is the right place — outside, where a wrong answer can be reported — and /submit refuses
# with 503 regardless, so an unconfigured container still cannot accept anything.
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/health >/dev/null 2>&1 || exit 1

CMD ["node", "apps/submission-api/server.mjs"]
